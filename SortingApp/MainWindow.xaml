<Window x:Class="SortingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SortingApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Сортировка данных" FontSize="20"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Border Grid.Row="1" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel Margin="0,0,0,10">
                    <Button x:Name="btnGenerate" Content="Сгенерировать массив" Width="150" Margin="5" Click="btnGenerate_Click"/>
                    <Button x:Name="btnLoadFile" Content="Загрузить из файла" Width="150" Margin="5" Click="btnLoadFile_Click"/>
                    <Button x:Name="btnSaveResult" Content="Сохранить результат" Width="150" Margin="5" Click="btnSaveResult_Click"/>
                    <Button x:Name="btnClear" Content="Очистить" Width="100" Margin="5" Click="btnClear_Click"/>
                    <Button x:Name="btnOpenAnalysis" Content="Сравнительный анализ" Width="150" Margin="5" Click="btnOpenAnalysis_Click"/>
                </WrapPanel>

                <WrapPanel Margin="0,0,0,10">
                    <TextBlock Text="Размер массива:" VerticalAlignment="Center" Margin="5"/>
                    <Slider x:Name="sliderArraySize" Minimum="1" Maximum="150" Value="10" 
                            Width="200" Margin="5" TickPlacement="BottomRight" TickFrequency="1" 
                            IsSnapToTickEnabled="False" SmallChange="1" LargeChange="10"/>
                    <TextBlock x:Name="txtArraySizeValue" Text="10" VerticalAlignment="Center" Margin="5" Width="30"/>
                    <TextBlock Text="Метод сортировки:" VerticalAlignment="Center" Margin="15,5,5,5"/>
                    <RadioButton x:Name="rbBubbleSort" Content="Метод обмена (Bubble Sort)" GroupName="SortMethod" 
                                 IsChecked="True" Margin="5"/>
                    <RadioButton x:Name="rbQuickSort" Content="Быстрая сортировка (Quick Sort)" GroupName="SortMethod" Margin="5"/>
                </WrapPanel>

                <WrapPanel>
                    <Button x:Name="btnSort" Content="Сортировать" Width="120" Margin="5" Click="btnSort_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderThickness="1" Padding="5" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Исходный массив:" />
                <TextBlock x:Name="txtOriginalArray" TextWrapping="Wrap" Margin="0,5,0,5"/>
                <TextBlock Text="Результат сортировки:"/>
                <TextBlock x:Name="txtSortedArray" TextWrapping="Wrap" Margin="0,5,0,5"/>
                <TextBlock Text="Статистика:" Margin="0,10,0,0"/>
                <TextBlock x:Name="txtStatistics" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="3" Header="Пошаговая демонстрация сортировки" Margin="0,0,0,10">
            <ScrollViewer>
                <RichTextBox x:Name="rtbStepByStep" IsReadOnly="True" 
                             FontFamily="Courier New" FontSize="12"
                             VerticalScrollBarVisibility="Auto"/>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Window>